{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokebowlfresh",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "STOCK_ADMIN_PIN": "vise2026"
  }
}
